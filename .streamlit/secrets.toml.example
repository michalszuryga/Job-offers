# Copy this file to .streamlit/secrets.toml and use it for local development.
# In Streamlit Cloud, set DATABASE_URL under App settings -> Secrets.
#
# Supabase Dashboard -> Connect -> Session pooler. Paste the exact connection
# string shown there. Session pooler uses IPv4 and works with Streamlit Cloud.
# Do not use the Direct connection string here; it resolves to IPv6 by default.
# Never commit your real secrets.toml or database password.

DATABASE_URL = "postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:5432/postgres"