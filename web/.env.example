# Copy to .env.local (gitignored). Both values are public by design; access is
# enforced by the RLS policies in ../db/web_access.sql.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Public URL of the app for the absolute og:url / og:image links in
# index.html (see vite.config.ts). Defaults to https://michalszuryga.github.io
# plus BASE_PATH; set it when the app moves to a custom domain.
# SITE_URL=https://joffers.example/
