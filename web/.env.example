# Copy to .env.local (gitignored). Both values are public by design; access is
# enforced by the RLS policies in ../db/web_access.sql.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Public URL of the app for the absolute og:url / og:image links in
# index.html (see vite.config.ts). Defaults to https://michalszuryga.github.io
# plus BASE_PATH; set it when the app moves to a custom domain.
# SITE_URL=https://joffers.example/

# The data controller and contact address shown on the privacy page (/privacy) and
# used by "Request access" (a mailto). The deploy (web-pages.yml) sets both from the
# repository variables CONTROLLER_NAME / CONTACT_EMAIL, falling back to the owner's.
# Locally they are optional: without them the page names no controller and the
# "Request access" links are hidden. With REQUIRE_PUBLIC_CONFIG=1 (the deploy sets it)
# the build fails if either is empty.
# VITE_CONTROLLER_NAME=Jane Doe
# VITE_CONTACT_EMAIL=privacy@example.com
